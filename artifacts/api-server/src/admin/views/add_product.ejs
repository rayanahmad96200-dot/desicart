<%- include('_header', { title: 'Add Product — DesiCart Admin', pageTitle: 'Add New Product', username, flash, currentPath }) %>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a href="/admin-panel/dashboard" class="btn btn-sm btn-light" style="border-radius:8px;"><i class="bi bi-arrow-left"></i> Back</a>
            <h5 class="mb-0 fw-bold">Add New Product</h5>
        </div>
        <div class="card">
            <div class="card-body p-4">
                <form method="POST" action="/admin-panel/products/add" enctype="multipart/form-data">

                    <div class="mb-4">
                        <label class="form-label">Product Image <span class="text-muted">(optional)</span></label>
                        <div id="dropzone" class="text-center p-4" style="border:2px dashed #e2e8f0;border-radius:12px;cursor:pointer;background:#fafafa;transition:all 0.2s;"
                            onclick="document.getElementById('imageInput').click()"
                            ondragover="event.preventDefault();this.style.borderColor='#e07b2a';"
                            ondragleave="this.style.borderColor='#e2e8f0';"
                            ondrop="handleDrop(event)">
                            <div id="dropzoneContent">
                                <i class="bi bi-cloud-upload" style="font-size:2.5rem;color:#cbd5e1;"></i>
                                <p class="mb-1 mt-2" style="color:#64748b;font-weight:500;">Click to upload or drag & drop</p>
                                <p class="mb-0" style="font-size:0.8rem;color:#94a3b8;">PNG, JPG, JPEG, GIF, WEBP — max 16MB</p>
                            </div>
                            <img id="previewImg" src="" alt="Preview" style="display:none;max-height:200px;border-radius:10px;object-fit:contain;">
                        </div>
                        <input type="file" name="image" id="imageInput" accept="image/*" style="display:none;" onchange="previewImage(this)">
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="removeImgBtn" style="display:none;border-radius:8px;" onclick="removeImage()">
                            <i class="bi bi-x me-1"></i>Remove Image
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Product Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Ultra 3 Smart Watch" required value="<%= formData.title || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tagline <span class="text-muted">(short subtitle)</span></label>
                        <input type="text" name="tagline" class="form-control" placeholder="e.g. Pakistan's Most Versatile Watch" value="<%= formData.tagline || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Describe the product features..."><%= formData.description || '' %></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Features <span class="text-muted">(one per line)</span></label>
                        <textarea name="features" class="form-control" rows="5" placeholder="Big Full HD Infinite Display&#10;7 Premium Straps Included&#10;Wireless Fast Charging"><%= formData.features || '' %></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Sale Price (Rs.) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius:8px 0 0 8px;background:#f8fafc;">Rs.</span>
                                <input type="number" name="price" class="form-control" placeholder="1,999" step="0.01" min="0" required value="<%= formData.price || '' %>" style="border-radius:0 8px 8px 0;">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Original Price (Rs.) <span class="text-muted">(optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="border-radius:8px 0 0 8px;background:#f8fafc;">Rs.</span>
                                <input type="number" name="original_price" class="form-control" placeholder="3,999" step="0.01" min="0" value="<%= formData.original_price || '' %>" style="border-radius:0 8px 8px 0;">
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label class="form-label">Category</label>
                            <select name="category" class="form-select">
                                <option value="">Select category</option>
                                <% for (const cat of ['Smart Watches', 'Earbuds', 'Speakers', 'Power Banks', 'Headphones', 'Accessories']) { %>
                                <option value="<%= cat %>" <%= formData.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Badge <span class="text-muted">(optional)</span></label>
                            <select name="badge" class="form-select">
                                <option value="">No badge</option>
                                <% for (const badge of ['Best Seller', 'New', 'Trending', 'Hot Pick', 'Summer Deal', 'Eco Pick', 'Limited', 'Outdoor']) { %>
                                <option value="<%= badge %>" <%= formData.badge === badge ? 'selected' : '' %>><%= badge %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4" style="border-radius:10px;"><i class="bi bi-plus-circle me-2"></i>Add Product</button>
                        <a href="/admin-panel/dashboard" class="btn btn-light px-4" style="border-radius:10px;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('_footer') %>
<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('dropzoneContent').style.display = 'none';
            const img = document.getElementById('previewImg');
            img.src = e.target.result; img.style.display = 'block';
            document.getElementById('removeImgBtn').style.display = 'inline-flex';
        };
        reader.readAsDataURL(input.files[0]);
    }
}
function removeImage() {
    document.getElementById('imageInput').value = '';
    document.getElementById('previewImg').style.display = 'none';
    document.getElementById('previewImg').src = '';
    document.getElementById('dropzoneContent').style.display = 'block';
    document.getElementById('removeImgBtn').style.display = 'none';
}
function handleDrop(e) {
    e.preventDefault();
    document.getElementById('dropzone').style.borderColor = '#e2e8f0';
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) {
        const input = document.getElementById('imageInput');
        const dt = new DataTransfer(); dt.items.add(file); input.files = dt.files;
        previewImage(input);
    }
}
</script>
</body>
</html>
